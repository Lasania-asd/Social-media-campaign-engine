# --- Writer (Claude) -------------------------------------------------------
# Without a key the app runs in offline mode: drafts are assembled from source facts only, and no research sweep.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Optional: a stronger model just for the weekly web research sweep
CLAUDE_RESEARCH_MODEL=claude-opus-5-5
RESEARCH_MAX_SEARCHES=8

# --- Access (100% internal) -----------------------------------------------
APP_PASSWORD=change-me
TEAM=Nasif,Ahsan,Anika,Lasania,Asif
PORT=4100
# Public base URL (used for media links sent to the scheduler webhook)
PUBLIC_URL=https://campaign.6sensehq.com

# --- Autopilot -------------------------------------------------------------
AUTOPILOT=on
# Cron expressions in Asia/Dhaka
SWEEP_CRON=0 5 * * 1
DAILY_CRON=0 8 * * *
# Slack incoming webhook / n8n / Zapier — reminders + digests
NOTIFY_WEBHOOK_URL=
# n8n / Zapier webhook that forwards posts to Fanpage Karma / Metricool / Buffer
SCHEDULER_WEBHOOK_URL=

# --- Rendering -------------------------------------------------------------
# Path to a Chromium binary (auto-detected from Playwright's cache if empty)
CHROMIUM_PATH=
# Where the SQLite DB and rendered visuals live
DATA_DIR=
BLOCKED_NAMES=Ome,Signal6,Signal 6
